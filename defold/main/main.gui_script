local function box(self, x, y, w, h, color, layer)
    local node = gui.new_box_node(vmath.vector3(x, y, layer or 0), vmath.vector3(w, h, 0))
    gui.set_color(node, color)
    self.nodes[#self.nodes + 1] = node
    return node
end

local function label(self, text, x, y, size, color)
    local node = gui.new_text_node(vmath.vector3(x, y, 0.2), text)
    gui.set_font(node, "default")
    gui.set_color(node, color or vmath.vector4(1, 1, 1, 1))
    gui.set_scale(node, vmath.vector3(size or 1, size or 1, 1))
    self.nodes[#self.nodes + 1] = node
    return node
end

local function draw(self)
    for _, node in ipairs(self.nodes) do
        gui.delete_node(node)
    end
    self.nodes = {}
    local w, h = gui.get_width(), gui.get_height()
    local tile = 48
    for y = 0, math.ceil(h / tile) do
        for x = 0, math.ceil(w / tile) do
            local c = (x + y) % 2 == 0 and vmath.vector4(0.10, 0.22, 0.18, 1) or vmath.vector4(0.12, 0.25, 0.20, 1)
            box(self, x * tile + tile / 2, y * tile + tile / 2, tile - 2, tile - 2, c, -0.1)
        end
    end
    box(self, w * 0.5, h * 0.48, w * 0.72, 72, vmath.vector4(0.30, 0.31, 0.30, 1), 0)
    box(self, w * 0.5, h * 0.48, w * 0.72, 3, vmath.vector4(0.42, 0.43, 0.40, 1), 0.01)
    box(self, self.hero.x, self.hero.y, 28, 32, vmath.vector4(0.18, 0.68, 1, 1), 0.1)
    box(self, self.hero.x, self.hero.y + 11, 18, 8, vmath.vector4(0.95, 0.78, 0.57, 1), 0.11)
    for _, e in ipairs(self.enemies) do
        if e.hp > 0 then
            box(self, e.x, e.y, 27, 27, e.elite and vmath.vector4(0.95, 0.24, 0.20, 1) or vmath.vector4(0.72, 0.28, 0.34, 1), 0.1)
            box(self, e.x, e.y + 20, 30, 4, vmath.vector4(0.12, 0.05, 0.05, 1), 0.2)
            local ratio = math.max(0, e.hp / e.max_hp)
            box(self, e.x - 15 + 15 * ratio, e.y + 20, 30 * ratio, 3, vmath.vector4(0.25, 0.95, 0.36, 1), 0.21)
        end
    end
    label(self, "ASTAGA-NAGA  |  DEFOLD RPG", 18, h - 24, 0.75, vmath.vector4(0.98, 0.88, 0.54, 1))
    label(self, "MAP " .. self.map .. "/10  |  LV " .. self.level .. "  |  EXP " .. self.exp .. "/" .. self.next_exp, 18, h - 49, 0.65)
    label(self, "HP " .. math.floor(self.hp) .. "/" .. self.max_hp .. "    GOLD " .. self.gold .. "    POTION " .. self.potions, 18, h - 72, 0.65)
    label(self, "DRAG TO MOVE  |  TAP ATTACK  |  SKILL", 18, 26, 0.62, vmath.vector4(0.85, 0.92, 1, 1))
    box(self, w - 56, 58, 72, 52, vmath.vector4(0.10, 0.35, 0.62, 0.95), 0.3)
    label(self, "SKILL", w - 56, 58, 0.55)
    box(self, w - 56, 120, 72, 52, vmath.vector4(0.60, 0.16, 0.16, 0.95), 0.3)
    label(self, "ATTACK", w - 56, 120, 0.48)
    box(self, w - 56, 182, 72, 52, vmath.vector4(0.20, 0.48, 0.24, 0.95), 0.3)
    label(self, "POTION", w - 56, 182, 0.48)
    if self.notice_timer > 0 then
        label(self, self.notice, w * 0.5, h * 0.72, 0.9, vmath.vector4(1, 0.91, 0.48, 1))
    end
end

local function notice(self, text)
    self.notice = text
    self.notice_timer = 1.6
end

local function spawn_enemy(self, index)
    local w, h = gui.get_width(), gui.get_height()
    local side = index % 4
    local x = side == 0 and w * 0.25 or (side == 1 and w * 0.72 or (side == 2 and w * 0.35 or w * 0.68))
    local y = h * (0.30 + ((index * 13) % 35) / 100)
    local elite = self.kills > 0 and self.kills % 10 == 9
    local hp = elite and 90 or 35
    self.enemies[#self.enemies + 1] = { x = x, y = y, hp = hp, max_hp = hp, elite = elite }
end

local function attack(self, radius, damage)
    local hit = false
    for _, e in ipairs(self.enemies) do
        if e.hp > 0 then
            local dx, dy = e.x - self.hero.x, e.y - self.hero.y
            if dx * dx + dy * dy <= radius * radius then
                e.hp = e.hp - damage
                hit = true
                if e.hp <= 0 then
                    self.kills = self.kills + 1
                    self.exp = self.exp + (e.elite and 35 or 10)
                    self.gold = self.gold + (e.elite and 25 or 5)
                    notice(self, e.elite and "ELITE DEFEATED! +EXP +GOLD" or "MONSTER DEFEATED! +EXP +GOLD")
                    if self.exp >= self.next_exp then
                        self.exp = self.exp - self.next_exp
                        self.level = self.level + 1
                        self.next_exp = math.floor(self.next_exp * 1.45)
                        self.max_hp = self.max_hp + 12
                        self.hp = self.max_hp
                        notice(self, "LEVEL UP! LV " .. self.level)
                    end
                end
            end
        end
    end
    if not hit then notice(self, "Swing! Get closer to a monster.") end
end

function init(self)
    msg.post(".", "acquire_input_focus")
    self.nodes = {}
    self.hero = { x = gui.get_width() * 0.5, y = gui.get_height() * 0.46 }
    self.enemies = {}
    self.hp, self.max_hp, self.gold, self.potions = 100, 100, 0, 3
    self.exp, self.next_exp, self.level = 0, 50, 1
    self.kills, self.map = 0, 1
    self.notice, self.notice_timer = "Welcome to Astaga-naga!", 2.5
    self.attack_cooldown, self.skill_cooldown = 0, 0
    self.move_target = nil
    for i = 1, 5 do spawn_enemy(self, i) end
    draw(self)
end

function update(self, dt)
    self.attack_cooldown = math.max(0, self.attack_cooldown - dt)
    self.skill_cooldown = math.max(0, self.skill_cooldown - dt)
    self.notice_timer = math.max(0, self.notice_timer - dt)
    if self.move_target then
        local dx, dy = self.move_target.x - self.hero.x, self.move_target.y - self.hero.y
        local d = math.sqrt(dx * dx + dy * dy)
        if d < 4 then
            self.move_target = nil
        else
            local step = math.min(d, 190 * dt)
            self.hero.x = self.hero.x + dx / d * step
            self.hero.y = self.hero.y + dy / d * step
        end
    end
    for _, e in ipairs(self.enemies) do
        if e.hp > 0 then
            local dx, dy = self.hero.x - e.x, self.hero.y - e.y
            local d = math.sqrt(dx * dx + dy * dy)
            if d > 28 then
                local step = math.min(d - 28, (e.elite and 52 or 36) * dt)
                e.x, e.y = e.x + dx / d * step, e.y + dy / d * step
            else
                self.hp = math.max(0, self.hp - (e.elite and 10 or 5) * dt)
            end
        end
    end
    if self.hp <= 0 then
        self.hp = self.max_hp
        self.hero.x, self.hero.y = gui.get_width() * 0.5, gui.get_height() * 0.46
        notice(self, "Revived! Use potion and keep moving.")
    end
    local alive = 0
    for _, e in ipairs(self.enemies) do if e.hp > 0 then alive = alive + 1 end end
    if alive == 0 then
        if self.kills >= self.map * 10 then
            if self.map < 10 then
                self.map = self.map + 1
                notice(self, "QUEST UNLOCKED: MAP " .. self.map)
            else
                self.map = 1
                notice(self, "ALL 10 MAPS CLEARED! New journey begins.")
            end
        end
        for i = 1, 5 do spawn_enemy(self, i + self.kills) end
    end
    self.redraw = (self.redraw or 0) - dt
    if self.redraw <= 0 then
        draw(self)
        self.redraw = 0.08
    end
end

function on_input(self, action_id, action)
    if action_id == hash("touch") then
        if action.pressed then
            local w = gui.get_width()
            if action.x > w - 100 and action.y < 220 and action.y > 150 then
                if self.potions > 0 then
                    self.potions = self.potions - 1
                    self.hp = math.min(self.max_hp, self.hp + 45)
                    notice(self, "Potion used: +45 HP")
                end
            elseif action.x > w - 100 and action.y < 150 and action.y > 90 then
                if self.attack_cooldown <= 0 then
                    attack(self, 90, 24)
                    self.attack_cooldown = 0.35
                end
            elseif action.x > w - 100 and action.y < 90 then
                if self.skill_cooldown <= 0 then
                    attack(self, 170, 55)
                    self.skill_cooldown = 8
                    notice(self, "ARCANE PULSE!")
                else
                    notice(self, "Skill cooling down...")
                end
            else
                self.move_target = { x = action.x, y = action.y }
            end
            draw(self)
        elseif action.released then
            self.move_target = nil
        end
    end
end
